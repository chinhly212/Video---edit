# Cấu hình cổng chạy Backend
PORT=8000
HOST=0.0.0.0

# Khóa API Google Gemini (Có thể nhập trực tiếp trên web hoặc điền ở đây)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PRIMARY_MODEL=gemini-1.5-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-pro

# Đường dẫn cài đặt FFmpeg (Nếu chưa thêm vào System PATH)
FFMPEG_PATH=/usr/bin/ffmpeg
